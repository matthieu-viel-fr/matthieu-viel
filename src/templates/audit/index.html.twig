{% extends 'base.html.twig' %}

{% block title %}Audit technique web freelance · Matthieu Viel — Réunion{% endblock %}
{% block meta_description %}Audit technique freelance par Matthieu Viel, Saint-Pierre La Réunion. Application vibe coding, dette technique SaaS, tests automatisés, CI/CD. 17 ans d'expérience, livrables concrets sous 5 jours.{% endblock %}

{% block og %}
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.matthieu-viel.fr/audit/">
  <meta property="og:title" content="Audit technique web freelance — Matthieu Viel, La Réunion">
  <meta property="og:description" content="Audit technique freelance senior : application IA, dette technique SaaS, tests automatisés, CI/CD. Livrables concrets. Saint-Pierre, Réunion 974.">
  <meta property="og:image" content="https://www.matthieu-viel.fr/assets/images/portrait.webp">
  <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block canonical %}
  <link rel="canonical" href="https://www.matthieu-viel.fr/audit/">
  <link rel="alternate" hreflang="fr" href="https://www.matthieu-viel.fr/audit/">
  <link rel="alternate" hreflang="en" href="https://www.matthieu-viel.fr/en/audit/">
  <link rel="alternate" hreflang="x-default" href="https://www.matthieu-viel.fr/audit/">
{% endblock %}

{% block schema_ld %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Matthieu Viel",
    "url": "https://www.matthieu-viel.fr",
    "jobTitle": "Senior Fullstack Developer & Technical Auditor",
    "knowsAbout": ["QA automatisée", "CI/CD", "audit technique", "stabilisation SaaS", "Cypress", "dette technique", "vibe coding audit"],
    "areaServed": ["La Réunion", "France", "Remote"],
    "sameAs": ["https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/"]
  }
  </script>
{% endblock %}

{% block nav %}
  <nav class="nav" id="nav" aria-label="Navigation principale">
    <div class="container nav__inner">
      <a href="../index.html" class="nav__logo" aria-label="Matthieu Viel — Accueil">
        <span class="nav__logo-name">Matthieu Viel</span>
        <span class="nav__logo-tagline">Consultant technique web</span>
      </a>

      <ul class="nav__links" id="nav-links">
        <li><a href="../index.html#problemes">Mes interventions</a></li>
        <li><a href="./" class="is-active" aria-current="page">Audit</a></li>
        <li><a href="../portfolio.html">Portfolio</a></li>
        <li><a href="../index.html#contact">Contact</a></li>
      </ul>

      <div class="lang-toggle" role="group" aria-label="Langue / Language">
        <a href="./" class="lang-toggle__btn lang-toggle__btn--active" hreflang="fr" aria-current="true">🇫🇷 FR</a>
        <a href="{{ lang_en_url }}" class="lang-toggle__btn" hreflang="en">🇬🇧 EN</a>
      </div>

      <a href="https://calendly.com/matthieu-viel-fr/30min"
         class="btn btn--primary nav__cta"
         target="_blank"
         rel="noopener noreferrer"
         aria-label="Réserver un appel découverte (ouvre Calendly)">
        Réserver un appel
      </a>

      <button type="button"
              class="nav__burger"
              id="nav-burger"
              aria-label="Ouvrir le menu"
              aria-expanded="false"
              aria-controls="nav-links">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
{% endblock %}

{% block body %}
  <main>

    <section class="portfolio-hero" aria-label="Audit technique — présentation">
      <div class="container">
        <p class="eyebrow">Audit technique freelance</p>
        <h1 class="portfolio-hero__title">
          Votre application a besoin d'un<br>
          <em>regard technique externe.</em>
        </h1>
        <p class="portfolio-hero__subtitle">
          Que vous ayez construit votre app avec l'IA, accumulé de la dette technique,
          ou que vous déployiez encore à la main : je diagnostique le problème réel
          et vous livre un plan d'action concret. Basé à Saint-Pierre, La Réunion.
          Interventions remote France entière.
        </p>
        <div class="cta-group">
          <a href="https://calendly.com/matthieu-viel-fr/30min"
             class="btn btn--primary btn--lg"
             target="_blank"
             rel="noopener noreferrer"
             aria-label="Réserver un appel découverte (ouvre Calendly)">
            Réserver un appel découverte →
          </a>
          <a href="faq/" class="btn btn--outline btn--lg">
            Questions fréquentes
          </a>
        </div>
        <div class="portfolio-hero__stats">
          <div class="portfolio-hero__stat">
            <span class="portfolio-hero__stat-number">17</span>
            <span class="portfolio-hero__stat-label">ans d'expérience</span>
          </div>
          <div class="portfolio-hero__stat">
            <span class="portfolio-hero__stat-number">5j</span>
            <span class="portfolio-hero__stat-label">délai livraison moyen</span>
          </div>
          <div class="portfolio-hero__stat">
            <span class="portfolio-hero__stat-number">500+</span>
            <span class="portfolio-hero__stat-label">scénarios de tests</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="cas-usage" aria-labelledby="cas-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">Cas d'usage</p>
          <h2 class="section-title" id="cas-title">Dans quelle situation êtes-vous ?</h2>
          <p class="section-subtitle">
            Six situations concrètes : chaque page répond directement à la question,
            avec le détail de ce que j'examine et ce que vous recevez.
          </p>
        </header>

        <div class="audit-grid">

          <a href="application-vibe-coding-production/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">Application IA</p>
            <h3 class="audit-card__title">Mon app a été développée avec l'IA : est-elle prête pour la production ?</h3>
            <p class="audit-card__desc">
              Vous avez utilisé Claude Code, Cursor ou Bolt. L'app fonctionne.
              Mais avant de l'exposer à de vrais clients, cinq points critiques
              doivent être vérifiés par quelqu'un qui n'a pas écrit le code.
            </p>
            <span class="audit-card__link">Lire la page →</span>
          </a>

          <a href="dette-technique-application-saas/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">SaaS existant</p>
            <h3 class="audit-card__title">Comment identifier et réduire la dette technique de mon SaaS ?</h3>
            <p class="audit-card__desc">
              Votre app "fonctionne" mais devient difficile à faire évoluer.
              L'audit produit un plan priorisé : ce qui bloque vraiment,
              ce qui peut attendre, et comment réduire progressivement sans tout casser.
            </p>
            <span class="audit-card__link">Lire la page →</span>
          </a>

          <a href="tests-automatises-application/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">Tests automatisés</p>
            <h3 class="audit-card__title">Comment mettre en place des tests automatisés quand il n'y en a pas ?</h3>
            <p class="audit-card__desc">
              Chaque déploiement est une source de stress. Je construis une couverture
              minimale viable avec Cypress en 10 à 15 jours, intégrée dans votre CI/CD
              pour que les tests tournent automatiquement.
            </p>
            <span class="audit-card__link">Lire la page →</span>
          </a>

          <a href="cicd-pipeline-application/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">CI/CD</p>
            <h3 class="audit-card__title">Comment déployer mon application sans stress avec un pipeline CI/CD ?</h3>
            <p class="audit-card__desc">
              Vous déployez encore à la main (FTP, SSH manuel). Je mets en place
              un pipeline GitHub Actions en 3 à 5 jours : lint → tests → déploiement.
              Sans sur-ingénierie.
            </p>
            <span class="audit-card__link">Lire la page →</span>
          </a>

          <a href="freelance-audit-technique-startup/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">Freelance vs cabinet</p>
            <h3 class="audit-card__title">Pourquoi un freelance senior plutôt qu'un cabinet pour un audit technique ?</h3>
            <p class="audit-card__desc">
              Un cabinet facture la coordination autant que l'expertise.
              Un freelance senior intervient directement sur votre codebase,
              vous répond sans filtre, et livre des recommandations applicables.
            </p>
            <span class="audit-card__link">Lire la page →</span>
          </a>

          <a href="application-solo-founder-clients/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">Solo founder</p>
            <h3 class="audit-card__title">J'ai développé mon app seul : comment savoir si je peux la proposer à mes clients ?</h3>
            <p class="audit-card__desc">
              Une app développée seul comporte presque toujours les mêmes angles morts.
              Avant vos premiers clients, huit points sont à vérifier :
              je les passe en revue en 2 à 3 jours.
            </p>
            <span class="audit-card__link">Lire la page →</span>
          </a>

        </div>
      </div>
    </section>

    <section class="section section--alt" id="faq-link" aria-label="FAQ">
      <div class="container prose-narrow--center">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 class="section-title">Coût, délais, périmètre, technologies</h2>
        <p class="section-subtitle section-subtitle--centered">
          Combien coûte un audit ? Quelle est la différence avec un pentest ?
          Qu'est-ce que le vibe coding ? Toutes les réponses directes en un seul endroit.
        </p>
        <a href="faq/" class="btn btn--primary btn--lg">
          Consulter la FAQ →
        </a>
      </div>
    </section>

    <section class="section section--dark" aria-label="Contact">
      <div class="container">
        <div class="inner-cta">
          <p class="eyebrow eyebrow--light">Première prise de contact</p>
          <h2 class="inner-cta__title">Décrivez-moi votre situation.</h2>
          <p class="inner-cta__text">
            30 minutes d'échange suffisent à poser le diagnostic de départ.
            Je lis tous les messages et réponds sous 24h.
          </p>
          <div class="inner-cta__actions">
            <a href="https://calendly.com/matthieu-viel-fr/30min"
               class="btn btn--outline-light btn--lg"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Réserver un appel découverte sur Calendly (nouvel onglet)">
              Réserver un appel découverte →
            </a>
            <a href="mailto:matthieu.viel.fr@gmail.com"
               class="btn btn--outline-light">
              matthieu.viel.fr@gmail.com
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
{% endblock %}

