          <li>
            <a href="https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Profil LinkedIn de Matthieu Viel (nouvel onglet)">
              LinkedIn
            </a>
          </li>
        </ul>
      </nav>

      <p class="footer__copy">© 2026 Matthieu Viel</p>
    </div>
  </footer>
{% endblock %}
