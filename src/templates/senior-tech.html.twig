{% block schema_ld %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Matthieu Viel",
    "jobTitle": "Développeur Fullstack Senior PHP/Symfony/React",
    "url": "https://www.matthieu-viel.fr/senior-tech.html",
    "image": "https://www.matthieu-viel.fr/assets/images/portrait.webp",
    "description": "Développeur fullstack senior PHP/Symfony/React, 17 ans d'expérience sur SaaS à fort trafic (Citeo 4 ans, Sellermania 7 ans). 500+ scénarios Cypress E2E. Modernisation legacy, Strangler Fig Pattern, CI/CD. Missions longues 3 à 12 mois, remote depuis La Réunion.",
    "knowsAbout": ["PHP 8", "Symfony", "API Platform", "React", "TypeScript", "Cypress", "CI/CD", "Docker", "Azure DevOps"],
    "sameAs": [
      "https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/",
      "https://www.malt.com/profile/matthieuviel"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Saint-Pierre",
      "addressRegion": "La Réunion",
      "postalCode": "97410",
      "addressCountry": "FR"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Missions senior Fullstack PHP/Symfony/React",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Modernisation legacy PHP/Symfony",
            "description": "Migration progressive Symfony 2/3/4 vers 6/7 avec Strangler Fig Pattern. Zéro downtime garanti."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "QA Cypress E2E et automatisation des tests",
            "description": "500+ scénarios automatisés écrits pour Citeo, 70% de couverture de tests atteinte. Formation QA incluse."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Renfort senior React/TypeScript",
            "description": "Refonte progressive frontend avec Strangler Fig Pattern et montée en compétence de l'équipe interne."
          }
        }
      ]
    }
  }
  </script>
{% endblock %}

{% block extra_styles %}
  <style>
    /* ---- Page anchor nav ---- */
    .page-nav {
      background: var(--clr-white);
      border-bottom: 1px solid var(--clr-border);
      position: sticky;
      top: var(--nav-height);
      z-index: 100;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .page-nav::-webkit-scrollbar { display: none; }
    .page-nav__inner {
      max-width: var(--container-max);
      margin-inline: auto;
      padding-inline: 1.5rem;
      display: flex;
    }
    .page-nav__link {
      display: inline-flex;
      align-items: center;
      padding: .75rem 1rem;
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--clr-muted);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
      transition: color var(--transition), border-color var(--transition);
    }
    .page-nav__link:hover {
      color: var(--clr-navy);
      border-bottom-color: var(--clr-blue);
    }

    /* ---- Stack categories ---- */
    .stack-cats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
      margin-top: 2.5rem;
    }
    .stack-cat {
      background: var(--clr-white);
      border: 1px solid var(--clr-border);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
    }
    .stack-cat__label {
      font-size: var(--fs-xs);
      font-weight: var(--fw-bold);
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--clr-blue);
      margin-bottom: 1rem;
    }
    .stack-cat__badges {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
    }
    .stack-cat__badge {
      display: inline-flex;
      align-items: center;
      padding: .35rem .75rem;
      background: var(--clr-bg-alt);
      border: 1px solid var(--clr-border);
      border-radius: var(--radius-full);
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      color: var(--clr-navy);
    }

    /* ---- Mission cards ---- */
    .missions__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .mission-card {
      background: var(--clr-white);
      border: 1px solid var(--clr-border);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: .75rem;
      transition: box-shadow var(--transition), transform var(--transition);
    }
    .mission-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
    .mission-card__icon {
      width: 48px;
      height: 48px;
      background: var(--clr-blue-light);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
    }
    .mission-card__title {
      font-size: var(--fs-base);
      font-weight: var(--fw-bold);
      color: var(--clr-navy);
      line-height: 1.3;
    }
    .mission-card__text {
      font-size: var(--fs-sm);
      color: var(--clr-slate);
      line-height: 1.7;
      flex: 1;
    }
    .mission-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
      margin-top: auto;
      padding-top: .5rem;
    }

    /* ---- Links strip (CTA dark section) ---- */
    .links-strip {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
      margin-top: 2rem;
    }
    .links-strip__item {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-size: var(--fs-sm);
      font-weight: var(--fw-semibold);
      color: #7dc4e8;
      text-decoration: none;
      transition: color var(--transition);
    }
    .links-strip__item:hover { color: var(--clr-white); }

    /* ---- Responsive overrides ---- */
    @media (max-width: 1024px) {
      .stack-cats { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
      .stack-cats    { grid-template-columns: 1fr; }
      .missions__grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .links-strip { gap: 1.25rem; }
    }
  </style>
{% endblock %}

{% block body %}
  <main>

    <section class="hero hero--centered" id="accueil" aria-label="Introduction">
      <div class="container">
        <div class="hero__grid">
          <div class="hero__content">
            <p class="hero__tag">Développeur Fullstack Senior · Remote France entière</p>

            <h1 class="hero__title">
              Renfort senior Symfony/React<br>
              <em>pour vos missions critiques.</em>
            </h1>

            <p class="hero__subtitle">
              17 ans sur des SaaS à fort trafic. Je rejoins votre équipe, je sécurise votre prod
              et je monte vos développeurs en compétence.
              Basé à La Réunion, disponible partout en France.
            </p>

            <div class="hero__ctas">
              <a href="https://calendly.com/matthieu-viel-fr/30min"
                 class="btn btn--primary btn--lg"
                 target="_blank"
                 rel="noopener noreferrer"
                 aria-label="Planifier un échange sur Calendly (ouvre dans un nouvel onglet)">
                Planifier un échange →
              </a>
              <a href="https://www.malt.com/profile/matthieuviel"
                 class="btn btn--outline btn--lg"
                 target="_blank"
                 rel="noopener noreferrer"
                 aria-label="Voir mon profil Malt (ouvre dans un nouvel onglet)">
                Voir mon profil Malt
              </a>
            </div>

            <hr class="hero__divider" aria-hidden="true">

            <ul class="hero__stats">
              <li class="hero__stat">
                <span class="hero__stat-number">17</span>
                <span class="hero__stat-label">ans d'expérience</span>
              </li>
              <li class="hero__stat">
                <span class="hero__stat-number">500+</span>
                <span class="hero__stat-label">scénarios de tests</span>
              </li>
              <li class="hero__stat">
                <span class="hero__stat-number">4 ans</span>
                <span class="hero__stat-label">sur Citeo (SaaS)</span>
              </li>
              <li class="hero__stat">
                <span class="hero__stat-number">7 ans</span>
                <span class="hero__stat-label">sur Sellermania</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <nav class="page-nav" aria-label="Navigation de la page">
      <div class="page-nav__inner">
        <a href="#positionnement" class="page-nav__link">Positionnement</a>
        <a href="#stack" class="page-nav__link">Stack</a>
        <a href="#experiences" class="page-nav__link">Expériences</a>
        <a href="#missions" class="page-nav__link">Missions</a>
        <a href="#pourquoi-moi" class="page-nav__link">Pourquoi moi</a>
        <a href="#temoignages" class="page-nav__link">Témoignages</a>
        <a href="#faq" class="page-nav__link">FAQ</a>
        <a href="#contact" class="page-nav__link">Contact</a>
      </div>
    </nav>

    <section class="section" id="positionnement" aria-labelledby="positionnement-title">
      <div class="container">
        <div class="about__grid">

          <div class="about__photo-wrap" aria-hidden="true">
            <img src="{{ asset_base }}assets/images/portrait.webp"
                 alt="Matthieu Viel, développeur fullstack senior basé à Saint-Pierre, La Réunion"
                 class="about__photo"
                 width="360"
                 height="450"
                 loading="lazy">
          </div>

          <div class="about__content">
            <p class="eyebrow">Positionnement</p>
            <h2 class="about__title" id="positionnement-title">
              Senior fullstack,<br>pas une ressource interchangeable.
            </h2>

            <p class="about__text">
              Je ne suis pas une ESN avec un catalogue de CVs. Je suis un développeur
              avec 17 ans de pratique concrète sur des SaaS à fort trafic : 4 ans sur Citeo,
              7 ans sur Sellermania, et une obsession pour la qualité logicielle.
            </p>

            <p class="about__text">
              Mon approche : rejoindre vos sprints, comprendre vos contraintes métier,
              livrer du code solide, et rendre votre équipe autonome.
              Pas de dépendance, pas de jargon.
            </p>

            <div class="about__highlights">
              <div class="about__highlight">
                <div class="about__highlight-icon" aria-hidden="true">📍</div>
                <div class="about__highlight-text">
                  <strong>Saint-Pierre, La Réunion (974)</strong>
                  Full remote ou déplacements ponctuels, France entière
                </div>
              </div>
              <div class="about__highlight">
                <div class="about__highlight-icon" aria-hidden="true">⏱️</div>
                <div class="about__highlight-text">
                  <strong>Missions longues : 3 à 12 mois</strong>
                  Régie ou forfait, temps plein ou partiel selon vos besoins
                </div>
              </div>
              <div class="about__highlight">
                <div class="about__highlight-icon" aria-hidden="true">🏅</div>
                <div class="about__highlight-text">
                  <strong>Formateur certifié ECP Formation</strong>
                  Je transmets les bonnes pratiques, je ne crée pas de dépendance
                </div>
              </div>
              <div class="about__highlight">
                <div class="about__highlight-icon" aria-hidden="true">🏔️</div>
                <div class="about__highlight-text">
                  <strong>Endurance et fiabilité</strong>
                  Finisher UTOI 117 km. La même rigueur dans la durée s'applique aux projets.
                </div>
              </div>
            </div>

            <div class="cta-group">
              <a href="https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/"
                 class="btn btn--outline"
                 target="_blank"
                 rel="noopener noreferrer"
                 aria-label="Voir le profil LinkedIn de Matthieu Viel (nouvel onglet)">
                LinkedIn →
              </a>
              <a href="https://www.malt.com/profile/matthieuviel"
                 class="btn btn--outline"
                 target="_blank"
                 rel="noopener noreferrer"
                 aria-label="Voir le profil Malt de Matthieu Viel (nouvel onglet)">
                Malt →
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="section section--alt" id="stack" aria-labelledby="stack-title">
      <div class="container">
        <header class="section-header section-header--center">
          <p class="eyebrow">Stack technique</p>
          <h2 class="section-title" id="stack-title">Maîtrise complète du cycle Symfony/React.</h2>
          <p class="section-subtitle">
            Développement, tests, CI/CD : j'interviens sur l'ensemble du cycle de vie d'une application web.
          </p>
        </header>

        <div class="stack-cats fade-up">
          <div class="stack-cat">
            <p class="stack-cat__label">Backend</p>
            <div class="stack-cat__badges">
              <span class="stack-cat__badge">PHP 8</span>
              <span class="stack-cat__badge">Symfony 6/7</span>
              <span class="stack-cat__badge">API Platform</span>
              <span class="stack-cat__badge">Doctrine</span>
              <span class="stack-cat__badge">PHPUnit</span>
              <span class="stack-cat__badge">Behat</span>
              <span class="stack-cat__badge">MySQL</span>
            </div>
          </div>
          <div class="stack-cat">
            <p class="stack-cat__label">Frontend</p>
            <div class="stack-cat__badges">
              <span class="stack-cat__badge">React</span>
              <span class="stack-cat__badge">TypeScript</span>
              <span class="stack-cat__badge">React Admin</span>
              <span class="stack-cat__badge">Material UI</span>
              <span class="stack-cat__badge">Jest</span>
            </div>
          </div>
          <div class="stack-cat">
            <p class="stack-cat__label">Tests</p>
            <div class="stack-cat__badges">
              <span class="stack-cat__badge">Cypress E2E</span>
              <span class="stack-cat__badge">Cypress Components</span>
              <span class="stack-cat__badge">PHPUnit</span>
              <span class="stack-cat__badge">Jest</span>
              <span class="stack-cat__badge">Behat</span>
              <span class="stack-cat__badge">Selenium</span>
            </div>
          </div>
          <div class="stack-cat">
            <p class="stack-cat__label">DevOps</p>
            <div class="stack-cat__badges">
              <span class="stack-cat__badge">Docker</span>
              <span class="stack-cat__badge">GitHub Actions</span>
              <span class="stack-cat__badge">Azure DevOps</span>
              <span class="stack-cat__badge">Gitea</span>
              <span class="stack-cat__badge">Jenkins</span>
              <span class="stack-cat__badge">Debian</span>
            </div>
          </div>
        </div>

        <p class="solution__note">
          Agile/Scrum · Code review · Pair programming · Documentation · Jira · Git
        </p>
      </div>
    </section>

    <section class="section" id="experiences" aria-labelledby="experiences-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">Expériences clés</p>
          <h2 class="section-title" id="experiences-title">17 ans sur des projets à fort enjeu.</h2>
          <p class="section-subtitle">
            Des missions longues, des résultats mesurables, des équipes formées.
          </p>
        </header>

        <div class="portfolio__featured">

          <article class="portfolio-card fade-up">
            <div class="portfolio-card__header">
              <div class="portfolio-card__meta">
                <span class="portfolio-card__sector">Citeo · SaaS environnemental · 9 mois · 2024-2025</span>
                <span class="portfolio-card__status portfolio-card__status--prod">Terminé</span>
              </div>
              <h3 class="portfolio-card__title">Automatisation complète des tests E2E sur une plateforme critique</h3>
            </div>
            <div class="portfolio-card__body">
              <p class="portfolio-card__context">
                <strong>Contexte :</strong> Citeo gère les filières de recyclage à l'échelle nationale.
                La plateforme (API Platform, React) n'avait pas de couverture de tests automatisés.
                Les déploiements étaient risqués et les régressions fréquentes.
              </p>
              <p class="portfolio-card__solution">
                <strong>Intervention :</strong> Conception et écriture de 500+ scénarios Cypress E2E
                sur les parcours critiques (authentification, formulaires, flux métier RGPD).
                Formation de 2 ingénieurs QA. Intégration dans le pipeline Azure DevOps.
              </p>
              <ul class="portfolio-card__results">
                <li>70% de couverture de tests atteinte</li>
                <li>Zéro régression en prod après déploiement</li>
                <li>2 ingénieurs QA formés à l'automatisation Cypress</li>
                <li>Pipeline CI/CD Azure DevOps opérationnel</li>
              </ul>
            </div>
            <div class="portfolio-card__footer">
              <div class="case-card__tags">
                <span class="tag">Cypress</span>
                <span class="tag">API Platform</span>
                <span class="tag">React</span>
                <span class="tag">Azure DevOps</span>
                <span class="tag">QA</span>
              </div>
            </div>
          </article>

          <article class="portfolio-card fade-up">
            <div class="portfolio-card__header">
              <div class="portfolio-card__meta">
                <span class="portfolio-card__sector">Citeo · SaaS environnemental · 3 ans · 2021-2024</span>
                <span class="portfolio-card__status portfolio-card__status--prod">Terminé</span>
              </div>
              <h3 class="portfolio-card__title">Développement fullstack sur une plateforme Symfony/API Platform/React</h3>
            </div>
            <div class="portfolio-card__body">
              <p class="portfolio-card__context">
                <strong>Contexte :</strong> Rejoindre une équipe Agile Scrum sur un SaaS
                à fort trafic, avec des cycles de sprints réguliers et des mises en production fréquentes.
                Mission 100% remote depuis La Réunion.
              </p>
              <p class="portfolio-card__solution">
                <strong>Intervention :</strong> Développement de nouvelles fonctionnalités
                (Symfony 6, API Platform, React/TypeScript). Mise en place des premières
                suites de tests E2E Cypress. Revues de code et cérémonies Agile.
              </p>
              <ul class="portfolio-card__results">
                <li>3 ans de mission fullstack sur une codebase complexe</li>
                <li>Premiers tests E2E mis en place en autonomie</li>
                <li>Collaboration avec une équipe distribuée, full remote</li>
              </ul>
            </div>
            <div class="portfolio-card__footer">
              <div class="case-card__tags">
                <span class="tag">Symfony 6</span>
                <span class="tag">API Platform</span>
                <span class="tag">React</span>
                <span class="tag">TypeScript</span>
                <span class="tag">Agile Scrum</span>
              </div>
            </div>
          </article>

          <article class="portfolio-card fade-up">
            <div class="portfolio-card__header">
              <div class="portfolio-card__meta">
                <span class="portfolio-card__sector">Sellermania · SaaS e-commerce · 7 ans · 2011-2018</span>
                <span class="portfolio-card__status portfolio-card__status--prod">Terminé</span>
              </div>
              <h3 class="portfolio-card__title">7 ans sur un SaaS de gestion de catalogue e-commerce</h3>
            </div>
            <div class="portfolio-card__body">
              <p class="portfolio-card__context">
                <strong>Contexte :</strong> Sellermania est un SaaS de synchronisation de catalogues
                pour marketplaces (Amazon, eBay, Cdiscount). Application critique, clients actifs en permanence,
                zéro tolérance au downtime.
              </p>
              <p class="portfolio-card__solution">
                <strong>Intervention :</strong> Développement de fonctionnalités PHP/Symfony.
                Migration progressive Symfony 2 vers 3 puis 4 sans interruption de service.
                Mise en place des tests unitaires et fonctionnels (PHPUnit, Behat, Selenium).
                CI/CD Jenkins.
              </p>
              <ul class="portfolio-card__results">
                <li>7 ans de maintenance et évolution en continu</li>
                <li>Migration Symfony 2 vers 4 : zéro downtime</li>
                <li>Base de tests unitaires et fonctionnels construite from scratch</li>
                <li>CI/CD Jenkins opérationnel</li>
              </ul>
            </div>
            <div class="portfolio-card__footer">
              <div class="case-card__tags">
                <span class="tag">PHP</span>
                <span class="tag">Symfony</span>
                <span class="tag">PHPUnit</span>
                <span class="tag">Behat</span>
                <span class="tag">Jenkins</span>
                <span class="tag">MySQL</span>
              </div>
            </div>
          </article>

          <article class="portfolio-card fade-up">
            <div class="portfolio-card__header">
              <div class="portfolio-card__meta">
                <span class="portfolio-card__sector">Mission freelance · React/TypeScript · 2026</span>
                <span class="portfolio-card__status portfolio-card__status--wip">En cours</span>
              </div>
              <h3 class="portfolio-card__title">Refonte progressive du frontend React sans tout casser</h3>
            </div>
            <div class="portfolio-card__body">
              <p class="portfolio-card__context">
                <strong>Contexte :</strong> Application React/TypeScript vieillissante, équipe
                interne réticente à refactoriser. Besoin d'un renfort senior pour moderniser
                sans interrompre la production ni perdre l'équipe en route.
              </p>
              <p class="portfolio-card__solution">
                <strong>Intervention :</strong> Adoption du Strangler Fig Pattern pour une
                migration progressive. Intégration du toolkit Aurora.
                Transmission des bonnes pratiques à l'équipe pour une autonomie complète.
              </p>
              <ul class="portfolio-card__results">
                <li>Continuité garantie : zéro refonte totale</li>
                <li>Équipe rendue autonome sur le nouveau périmètre</li>
              </ul>
            </div>
            <div class="portfolio-card__footer">
              <div class="case-card__tags">
