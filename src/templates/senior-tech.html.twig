{% block og %}
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.matthieu-viel.fr/senior-tech.html">
  <meta property="og:title" content="Matthieu Viel · Dev Fullstack Senior Symfony/React · Missions longues">
  <meta property="og:description" content="Développeur fullstack senior Symfony/React, 17 ans sur SaaS. Missions 3 à 12 mois, remote La Réunion.">
