{% block canonical %}
  <link rel="canonical" href="https://www.matthieu-viel.fr/senior-tech.html">
  <link rel="alternate" hreflang="fr" href="https://www.matthieu-viel.fr/senior-tech.html">
  <link rel="alternate" hreflang="x-default" href="https://www.matthieu-viel.fr/senior-tech.html">
