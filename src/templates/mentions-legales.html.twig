{% extends 'base.html.twig' %}

{% block title %}Mentions légales · Matthieu Viel — Consultant web Réunion{% endblock %}
{% block meta_description %}Mentions légales du site matthieu-viel.fr : éditeur, contact, propriété intellectuelle, hébergement et données personnelles.{% endblock %}

{% block og %}
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.matthieu-viel.fr/mentions-legales.html">
  <meta property="og:title" content="Mentions légales · Matthieu Viel">
  <meta property="og:description" content="Informations légales du site matthieu-viel.fr.">
  <meta property="og:image" content="https://www.matthieu-viel.fr/assets/images/portrait.webp">
  <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block canonical %}
