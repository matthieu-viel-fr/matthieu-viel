{% extends 'base.html.twig' %}

{% block title %}Matthieu Viel · Contact : email, téléphone · Réunion 974{% endblock %}
{% block meta_description %}Contactez Matthieu Viel par email, téléphone ou Calendly à Saint-Pierre 974, La Réunion. Suivez-le sur LinkedIn, Instagram, TikTok et Malt : sans jargon.{% endblock %}

{% block og %}
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.matthieu-viel.fr/contact.html">
  <meta property="og:title" content="Matthieu Viel · Contact : email, téléphone">
  <meta property="og:description" content="Email, téléphone, Calendly, LinkedIn, Instagram, TikTok, Malt : tous les moyens de me contacter et de me suivre.">
  <meta property="og:image" content="https://www.matthieu-viel.fr/assets/images/portrait.webp">
  <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block canonical %}
  <link rel="canonical" href="https://www.matthieu-viel.fr/contact.html">
  <link rel="alternate" hreflang="fr" href="https://www.matthieu-viel.fr/contact.html">
  <link rel="alternate" hreflang="en" href="https://www.matthieu-viel.fr/en/contact.html">
  <link rel="alternate" hreflang="x-default" href="https://www.matthieu-viel.fr/contact.html">
{% endblock %}

{% block schema_ld %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Matthieu Viel",
    "jobTitle": "Développeur Fullstack Senior",
    "url": "https://www.matthieu-viel.fr/contact.html",
    "image": "https://www.matthieu-viel.fr/assets/images/portrait.webp",
    "description": "Développeur fullstack indépendant à La Réunion, 18 ans d'expérience. Conseils informatiques sans jargon pour entrepreneurs et dirigeants de petite structure.",
    "telephone": "+262693852812",
    "email": "matthieu.viel.fr@gmail.com",
    "sameAs": [
      "https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/",
      "https://www.instagram.com/matthieuviel",
      "https://www.tiktok.com/@matthieu.viel6",
      "https://www.malt.com/profile/matthieuviel"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Saint-Pierre",
      "addressRegion": "La Réunion",
      "postalCode": "97410",
      "addressCountry": "FR"
    }
  }
  </script>
{% endblock %}

{% block extra_styles %}
  <style>
    /* ---- Contact page : bandeau clair + bandeau blanc ---- */
    .contact-band {
      padding-block: calc(var(--nav-height) + 4rem) var(--section-v-pad);
      background: linear-gradient(145deg, #f2f7fb 0%, #e4eef7 100%);
    }

    .contact-band__header { margin-bottom: 3rem; }

    .contact-identity {
      display: flex;
      align-items: center;
      gap: .875rem;
      margin-bottom: 1.75rem;
    }

    .contact-identity__avatar {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center top;
      border: 3px solid var(--clr-white);
      box-shadow: var(--shadow-sm);
      flex-shrink: 0;
    }

    .contact-identity__name {
      font-size: var(--fs-base);
      font-weight: var(--fw-bold);
      color: var(--clr-navy);
    }

    .contact-identity__location {
      font-size: var(--fs-xs);
      font-weight: var(--fw-medium);
      color: var(--clr-slate);
      margin-top: .15rem;
    }

    .contact-band__title {
      font-size: clamp(1.875rem, 3.5vw, 2.75rem);
      font-weight: var(--fw-extrabold);
      line-height: 1.15;
      color: var(--clr-navy);
      margin-bottom: 1rem;
    }

    .contact-band__title em {
      font-style: normal;
      color: var(--clr-blue);
    }

    .contact-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .contact-cards--social { grid-template-columns: repeat(4, 1fr); }

    .contact-card__icon {
      width: 48px;
      height: 48px;
      background: var(--clr-blue-light);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
    }

    /* Les libellés de contact (email, numéro) sont longs : on autorise
       le retour à la ligne, que .btn interdit par défaut. */
    .contact-card .btn {
      white-space: normal;
      text-align: center;
      justify-content: center;
    }

    @media (max-width: 1024px) {
      .contact-cards--social { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      .contact-band { padding-block: calc(var(--nav-height) + 2.5rem) var(--section-v-pad); }
      .contact-cards,
      .contact-cards--social { grid-template-columns: 1fr; }
    }
  </style>
{% endblock %}

{% block body %}
  <main>

    <section class="contact-band" id="contact" aria-labelledby="contact-title">
      <div class="container">

        <header class="contact-band__header">
          <div class="contact-identity">
            <img src="{{ asset_base }}assets/images/portrait.webp"
                 alt="Matthieu Viel, développeur web freelance à Saint-Pierre, La Réunion"
                 class="contact-identity__avatar"
                 width="64" height="64">
            <div>
              <p class="contact-identity__name">Matthieu Viel</p>
              <p class="contact-identity__location">📍 Saint-Pierre · La Réunion 974 · Remote France entière</p>
            </div>
          </div>

          <p class="eyebrow">Contact</p>
          <h1 class="contact-band__title" id="contact-title">
            Contactez-moi<br>
            <em>directement, sans intermédiaire</em>
          </h1>
          <p class="section-subtitle">
            Un audit technique, un bug bloquant, un projet à cadrer : décrivez-moi votre
            besoin en quelques lignes. Je réponds sous 24h.
          </p>
        </header>

        <div class="contact-cards">

          <article class="case-card contact-card fade-up">
            <div class="contact-card__icon" aria-hidden="true">✉️</div>
            <h2 class="case-card__title">Email</h2>
            <p class="case-card__text">
              Le moyen le plus direct. Décrivez votre situation en quelques lignes,
              je réponds sous 24h.
            </p>
            <a href="mailto:matthieu.viel.fr@gmail.com"
               class="btn btn--primary"
               data-cta="email"
               aria-label="Envoyer un email à Matthieu Viel">
              matthieu.viel.fr@gmail.com
            </a>
          </article>

          <article class="case-card contact-card fade-up">
            <div class="contact-card__icon" aria-hidden="true">📞</div>
            <h2 class="case-card__title">Téléphone</h2>
            <p class="case-card__text">
              Pour une question rapide ou une mise en ligne urgente.
              Heure de La Réunion, du lundi au vendredi.
            </p>
            <a href="tel:+262693852812"
               class="btn btn--outline"
               data-cta="phone"
               aria-label="Appeler Matthieu Viel">
              +262&nbsp;693&nbsp;85&nbsp;28&nbsp;12
            </a>
          </article>

          <article class="case-card contact-card fade-up">
            <div class="contact-card__icon" aria-hidden="true">📅</div>
            <h2 class="case-card__title">Échange gratuit</h2>
            <p class="case-card__text">
              30 minutes d'échange suffisent à poser le diagnostic de départ.
              Sans engagement.
            </p>
            <a href="https://calendly.com/matthieu-viel-fr/30min"
               class="btn btn--outline"
               target="_blank"
               rel="noopener noreferrer"
               data-cta="calendly"
               aria-label="Réserver un échange gratuit de 30 minutes sur Calendly (nouvel onglet)">
              Réserver un créneau →
            </a>
          </article>

        </div>
      </div>
    </section>

    <section class="section" id="social" aria-labelledby="social-title">
      <div class="container">

        <header class="section-header">
          <p class="eyebrow">Réseaux</p>
          <h2 class="section-title" id="social-title">Suivez-moi pour des conseils informatiques sans jargon</h2>
          <p class="section-subtitle">
            Sur LinkedIn, des réflexes de sécurité accessibles à tout dirigeant de petite
            structure. Sur Instagram et TikTok, une série de 9 vidéos tournée avec
            Marc Ah-Thione sur la sécurité et la qualité d'une application.
          </p>
        </header>

        <div class="contact-cards contact-cards--social">

          <article class="case-card contact-card fade-up">
            <div class="contact-card__icon" aria-hidden="true">🔗</div>
            <h3 class="case-card__title">LinkedIn</h3>
            <p class="case-card__text">
              Des réflexes de sécurité informatique accessibles à tout entrepreneur,
              pas seulement aux professionnels IT.
            </p>
            <a href="https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/"
               class="btn btn--outline"
               target="_blank"
               rel="noopener noreferrer"
               data-cta="linkedin"
               aria-label="Voir le profil LinkedIn de Matthieu Viel (nouvel onglet)">
              Voir le profil →
            </a>
          </article>

          <article class="case-card contact-card fade-up">
            <div class="contact-card__icon" aria-hidden="true">📸</div>
            <h3 class="case-card__title">Instagram</h3>
            <p class="case-card__text">
              La série tournée avec Marc Ah-Thione, et les coulisses des tournages.
            </p>
            <a href="https://www.instagram.com/matthieuviel"
               class="btn btn--outline"
               target="_blank"
               rel="noopener noreferrer"
               data-cta="instagram"
               aria-label="Voir le profil Instagram de Matthieu Viel (nouvel onglet)">
              Voir le profil →
            </a>
          </article>

          <article class="case-card contact-card fade-up">
            <div class="contact-card__icon" aria-hidden="true">🎬</div>
            <h3 class="case-card__title">TikTok</h3>
            <p class="case-card__text">
              Les mêmes conseils informatiques, en vidéos courtes.
            </p>
            <a href="https://www.tiktok.com/@matthieu.viel6"
               class="btn btn--outline"
               target="_blank"
               rel="noopener noreferrer"
               data-cta="tiktok"
               aria-label="Voir le profil TikTok de Matthieu Viel (nouvel onglet)">
              Voir le profil →
            </a>
          </article>

          <article class="case-card contact-card fade-up">
            <div class="contact-card__icon" aria-hidden="true">💼</div>
            <h3 class="case-card__title">Malt</h3>
            <p class="case-card__text">
              Profil freelance, avis vérifiés et missions passées.
            </p>
            <a href="https://www.malt.com/profile/matthieuviel"
               class="btn btn--outline"
               target="_blank"
               rel="noopener noreferrer"
               data-cta="malt"
               aria-label="Voir le profil Malt de Matthieu Viel (nouvel onglet)">
              Voir le profil →
            </a>
          </article>

        </div>
      </div>
    </section>

  </main>
{% endblock %}

{% block before_scripts %}
  <script>
    (function () {
      window.plausible = window.plausible || function () {
        (window.plausible.q = window.plausible.q || []).push(arguments);
      };
      document.querySelectorAll('[data-cta]').forEach(function (el) {
        el.addEventListener('click', function () {
          window.plausible('CTA Click', { props: { link: el.dataset.cta } });
        });
      });
    })();
  </script>
{% endblock %}
