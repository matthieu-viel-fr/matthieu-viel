{% extends 'base.html.twig' %}

{% block title %}Freelance Technical Audit · Matthieu Viel — Réunion Island{% endblock %}
{% block meta_description %}Freelance technical audit by Matthieu Viel, Saint-Pierre Réunion Island. AI-built apps, SaaS technical debt, automated testing, CI/CD pipelines. 17 years of experience, timeline adapted to your project.{% endblock %}

{% block og %}
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.matthieu-viel.fr/en/audit/">
  <meta property="og:title" content="Freelance Technical Audit — Matthieu Viel, Réunion Island">
  <meta property="og:description" content="Senior freelance technical audit: AI-built apps, SaaS technical debt, automated tests, CI/CD. Concrete deliverables. Saint-Pierre, Réunion 974.">
  <meta property="og:image" content="https://www.matthieu-viel.fr/assets/images/portrait.webp">
  <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block canonical %}
  <link rel="canonical" href="https://www.matthieu-viel.fr/en/audit/">
  <link rel="alternate" hreflang="fr" href="https://www.matthieu-viel.fr/audit/">
  <link rel="alternate" hreflang="en" href="https://www.matthieu-viel.fr/en/audit/">
  <link rel="alternate" hreflang="x-default" href="https://www.matthieu-viel.fr/audit/">
{% endblock %}

{% block schema_ld %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Matthieu Viel",
    "url": "https://www.matthieu-viel.fr",
    "jobTitle": "Senior Fullstack Developer & Technical Auditor",
    "knowsAbout": ["automated QA", "CI/CD", "technical audit", "SaaS stabilisation", "Cypress", "technical debt", "vibe coding audit"],
    "areaServed": ["Réunion Island", "France", "Remote"],
    "sameAs": ["https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/"]
  }
  </script>
{% endblock %}

{% block body %}
  <main>

    <section class="portfolio-hero" aria-label="Technical audit — overview">
      <div class="container">
        <p class="eyebrow">Freelance technical audit</p>
        <h1 class="portfolio-hero__title">
          Your application needs an<br>
          <em>external technical review.</em>
        </h1>
        <p class="portfolio-hero__subtitle">
          Whether you built your app with AI, accumulated technical debt,
          or you still deploy by hand: I diagnose the real problem
          and deliver a concrete action plan. Based in Saint-Pierre, Réunion Island.
          Remote across France.
        </p>
        <div class="cta-group">
          <a href="https://calendly.com/matthieu-viel-fr/30min"
             class="btn btn--primary btn--lg"
             target="_blank"
             rel="noopener noreferrer"
             aria-label="Book a discovery call (opens Calendly)">
            Book a discovery call →
          </a>
          <a href="faq/" class="btn btn--outline btn--lg">
            Frequently asked questions
          </a>
        </div>
        <div class="portfolio-hero__stats">
          <div class="portfolio-hero__stat">
            <span class="portfolio-hero__stat-number">17</span>
            <span class="portfolio-hero__stat-label">years of experience</span>
          </div>
          <div class="portfolio-hero__stat">
            <span class="portfolio-hero__stat-number">5d</span>
            <span class="portfolio-hero__stat-label">average delivery time</span>
          </div>
          <div class="portfolio-hero__stat">
            <span class="portfolio-hero__stat-number">500+</span>
            <span class="portfolio-hero__stat-label">test scenarios written</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="use-cases" aria-labelledby="cases-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">Use cases</p>
          <h2 class="section-title" id="cases-title">Which situation applies to you?</h2>
          <p class="section-subtitle">
            Seven concrete situations: each page answers the question directly,
            with a full breakdown of what I examine and what you receive.
          </p>
        </header>

        <div class="audit-grid">

          <a href="application-vibe-coding-production/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">AI-built app</p>
            <h3 class="audit-card__title">My app was built with AI: is it ready for production?</h3>
            <p class="audit-card__desc">
              You used Claude Code, Cursor or Bolt. The app works.
              But before exposing it to real users, five critical points
              need to be checked by someone who didn't write the code.
            </p>
            <span class="audit-card__link">Read the page →</span>
          </a>

          <a href="wetransform-integration-saas/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">B2B SaaS</p>
            <h3 class="audit-card__title">How to integrate WeTransform into a B2B SaaS application?</h3>
            <p class="audit-card__desc">
              Your customers send files in every format. I embed WeTransform into
              your product: embed, rule configuration, custom Power Functions
              and connections to your systems.
            </p>
            <span class="audit-card__link">Read the page →</span>
          </a>

          <a href="technical-debt-saas-application/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">Existing SaaS</p>
            <h3 class="audit-card__title">How do I identify and reduce technical debt in my SaaS?</h3>
            <p class="audit-card__desc">
              Your app "works" but is becoming hard to evolve.
              The audit produces a prioritised plan: what's actually blocking,
              what can wait, and how to reduce debt progressively without breaking things.
            </p>
            <span class="audit-card__link">Read the page →</span>
          </a>

          <a href="automated-tests-application/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">Automated testing</p>
            <h3 class="audit-card__title">How do I set up automated tests when there are none?</h3>
            <p class="audit-card__desc">
              Every deployment is stressful. I build a minimal viable coverage
              with Cypress, integrated into your CI/CD pipeline, scaled to your
              application's size so tests run automatically on every push.
            </p>
            <span class="audit-card__link">Read the page →</span>
          </a>

          <a href="cicd-pipeline-application/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">CI/CD</p>
            <h3 class="audit-card__title">How do I deploy my application without stress using CI/CD?</h3>
            <p class="audit-card__desc">
              You still deploy by hand (FTP, manual SSH). I set up a GitHub Actions
              pipeline adapted to your stack: lint → tests → deploy. No over-engineering.
            </p>
            <span class="audit-card__link">Read the page →</span>
          </a>

          <a href="freelance-technical-audit-startup/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">Freelance vs firm</p>
            <h3 class="audit-card__title">Why hire a senior freelance auditor instead of a consulting firm?</h3>
            <p class="audit-card__desc">
              A firm bills coordination as much as expertise.
              A senior freelance works directly on your codebase,
              answers without filters, and delivers actionable recommendations.
            </p>
            <span class="audit-card__link">Read the page →</span>
          </a>

          <a href="application-solo-founder-clients/" class="audit-card fade-up">
            <p class="audit-card__eyebrow">Solo founder</p>
            <h3 class="audit-card__title">I built my app alone: how do I know it's safe to offer to clients?</h3>
            <p class="audit-card__desc">
              Solo-built apps almost always have the same blind spots.
              Before your first clients, eight points need to be verified:
              I go through them at a pace that fits your urgency.
            </p>
            <span class="audit-card__link">Read the page →</span>
          </a>

        </div>
      </div>
    </section>

    <section class="section section--alt" id="faq-link" aria-label="FAQ">
      <div class="container prose-narrow--center">
        <p class="eyebrow">Frequently asked questions</p>
        <h2 class="section-title">Cost, timelines, scope, technologies</h2>
        <p class="section-subtitle section-subtitle--centered">
          How much does an audit cost? What's the difference with a pentest?
          What is vibe coding? All direct answers in one place.
        </p>
        <a href="faq/" class="btn btn--primary btn--lg">
          Read the FAQ →
        </a>
      </div>
    </section>

    <section class="section section--dark" aria-label="Contact">
      <div class="container">
        <div class="inner-cta">
          <p class="eyebrow eyebrow--light">First contact</p>
          <h2 class="inner-cta__title">Tell me about your situation.</h2>
          <p class="inner-cta__text">
            30 minutes is enough to get the initial diagnosis started.
            I read every message and reply within 24 hours.
          </p>
          <div class="inner-cta__actions">
            <a href="https://calendly.com/matthieu-viel-fr/30min"
               class="btn btn--outline-light btn--lg"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Book a discovery call on Calendly (new tab)">
              Book a discovery call →
            </a>
            <a href="mailto:matthieu.viel.fr@gmail.com"
               class="btn btn--outline-light">
              matthieu.viel.fr@gmail.com
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
{% endblock %}
