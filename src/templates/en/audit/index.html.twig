      </div>

      <nav aria-label="Footer links">
        <ul class="footer__links">
          <li><a href="../index.html">Home</a></li>
          <li><a href="./" aria-current="page">Technical Audit</a></li>
          <li><a href="../portfolio.html">Portfolio</a></li>
          <li><a href="../index.html#contact">Contact</a></li>
          <li><a href="../legal-notice.html">Legal notice</a></li>
          <li>
            <a href="https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Matthieu Viel's LinkedIn profile (new tab)">
              LinkedIn
            </a>
          </li>
        </ul>
      </nav>

      <p class="footer__copy">© 2026 Matthieu Viel</p>
    </div>
  </footer>
{% endblock %}
