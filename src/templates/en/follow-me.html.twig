{% extends 'base.html.twig' %}

{% block title %}Matthieu Viel · Follow me on social media · Saint-Pierre{% endblock %}
{% block meta_description %}Find Matthieu Viel on LinkedIn, Instagram, TikTok and Malt: jargon-free IT advice for entrepreneurs and small business owners, video series with Marc Ah-Thione.{% endblock %}

{% block og %}
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.matthieu-viel.fr/en/follow-me.html">
  <meta property="og:title" content="Matthieu Viel · Follow me on social media">
  <meta property="og:description" content="LinkedIn, Instagram, TikTok, Malt: jargon-free IT advice for entrepreneurs and small business owners.">
  <meta property="og:image" content="https://www.matthieu-viel.fr/assets/images/portrait.webp">
  <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block canonical %}
  <link rel="canonical" href="https://www.matthieu-viel.fr/en/follow-me.html">
  <link rel="alternate" hreflang="fr" href="https://www.matthieu-viel.fr/me-suivre.html">
  <link rel="alternate" hreflang="en" href="https://www.matthieu-viel.fr/en/follow-me.html">
  <link rel="alternate" hreflang="x-default" href="https://www.matthieu-viel.fr/me-suivre.html">
{% endblock %}

{% block schema_ld %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Matthieu Viel",
    "jobTitle": "Senior Fullstack Developer",
    "url": "https://www.matthieu-viel.fr/en/follow-me.html",
    "image": "https://www.matthieu-viel.fr/assets/images/portrait.webp",
    "description": "Independent fullstack developer in Réunion Island, 17 years of experience. Jargon-free IT advice for entrepreneurs and small business owners.",
    "sameAs": [
      "https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/",
      "https://www.instagram.com/matthieuviel",
      "https://www.tiktok.com/@matthieu.viel6",
      "https://www.malt.com/profile/matthieuviel"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Saint-Pierre",
      "addressRegion": "Réunion Island",
      "postalCode": "97410",
      "addressCountry": "FR"
    }
  }
  </script>
{% endblock %}

{% block extra_styles %}
  <style>
    /* ---- Link-in-bio layout ---- */
    .linkbio {
      min-height: 100dvh;
      padding: calc(var(--nav-height) + 2.5rem) 1.25rem 3rem;
      background: linear-gradient(145deg, #f2f7fb 0%, #e4eef7 100%);
      display: flex;
      justify-content: center;
    }

    .linkbio__card {
      width: 100%;
      max-width: 420px;
      text-align: center;
    }

    .linkbio__avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center top;
      box-shadow: var(--shadow-md);
      border: 3px solid var(--clr-white);
      margin: 0 auto .875rem;
    }

    .linkbio__name {
      font-size: var(--fs-lg);
      font-weight: var(--fw-extrabold);
      color: var(--clr-navy);
    }

    .linkbio__location {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      font-size: var(--fs-xs);
      font-weight: var(--fw-medium);
      color: var(--clr-muted);
      margin-top: .3rem;
      margin-bottom: 1.5rem;
    }

    .linkbio__headline {
      font-size: clamp(1.375rem, 6vw, 1.75rem);
      font-weight: var(--fw-extrabold);
      line-height: 1.3;
      color: var(--clr-navy);
      margin-bottom: .875rem;
    }

    .linkbio__bio {
      font-size: var(--fs-base);
      color: var(--clr-slate);
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    .linkbio__ctas {
      display: flex;
      flex-direction: column;
      gap: .875rem;
      margin-bottom: 1.5rem;
    }

    .linkbio__cta {
      width: 100%;
      min-height: 56px;
      justify-content: center;
      padding: .9rem 1.5rem;
      font-size: var(--fs-base);
      text-align: left;
    }

    .linkbio__cta-label { display: block; }
    .linkbio__cta-sub {
      display: block;
      font-size: var(--fs-xs);
      font-weight: var(--fw-medium);
      opacity: .8;
      margin-top: .1rem;
    }

    @media (max-width: 480px) {
      .linkbio { padding-inline: 1rem; }
    }
  </style>
{% endblock %}

{% block body %}
  <main class="linkbio">
    <div class="linkbio__card">
      <img src="{{ asset_base }}assets/images/portrait.webp"
           alt="Matthieu Viel, freelance web developer in Saint-Pierre, Réunion Island"
           class="linkbio__avatar"
           width="96" height="96">

      <p class="linkbio__name">Matthieu Viel</p>
      <p class="linkbio__location">📍 Saint-Pierre · Réunion Island</p>

      <h1 class="linkbio__headline">Follow me for jargon-free IT advice</h1>

      <p class="linkbio__bio">
        Independent fullstack developer, 17 years of experience. On LinkedIn, I share IT
        security habits that any entrepreneur or small business owner can use, not just IT
        professionals. On Instagram and TikTok, a 9-video series filmed with Marc Ah-Thione
        covers app security and code quality.
      </p>

      <div class="linkbio__ctas">
        <a href="https://www.linkedin.com/in/matthieu-viel-consultant-web-reunion/"
           class="btn btn--outline linkbio__cta"
           target="_blank"
           rel="noopener noreferrer"
           data-cta="linkedin"
           aria-label="View Matthieu Viel's LinkedIn profile (opens in a new tab)">
          <span>
            <span class="linkbio__cta-label">🔗 Follow me on LinkedIn</span>
            <span class="linkbio__cta-sub">Security and IT tips for business owners</span>
          </span>
        </a>

        <a href="https://www.instagram.com/matthieuviel"
           class="btn btn--outline linkbio__cta"
           target="_blank"
           rel="noopener noreferrer"
           data-cta="instagram"
           aria-label="View Matthieu Viel's Instagram profile (opens in a new tab)">
          <span>
            <span class="linkbio__cta-label">📸 Follow me on Instagram</span>
            <span class="linkbio__cta-sub">The series with Marc Ah-Thione, behind the scenes</span>
          </span>
        </a>

        <a href="https://www.tiktok.com/@matthieu.viel6"
           class="btn btn--outline linkbio__cta"
           target="_blank"
           rel="noopener noreferrer"
           data-cta="tiktok"
           aria-label="View Matthieu Viel's TikTok profile (opens in a new tab)">
          <span>
            <span class="linkbio__cta-label">🎬 Follow me on TikTok</span>
            <span class="linkbio__cta-sub">Quick IT tips in short videos</span>
          </span>
        </a>

        <a href="https://www.malt.com/profile/matthieuviel"
           class="btn btn--outline linkbio__cta"
           target="_blank"
           rel="noopener noreferrer"
           data-cta="malt"
           aria-label="View Matthieu Viel's Malt profile (opens in a new tab)">
          <span>
            <span class="linkbio__cta-label">💼 Malt profile</span>
            <span class="linkbio__cta-sub">Verified reviews, freelance missions</span>
          </span>
        </a>

        <a href="https://calendly.com/matthieu-viel-fr/30min"
           class="btn btn--primary linkbio__cta"
           target="_blank"
           rel="noopener noreferrer"
           data-cta="contact"
           aria-label="Book a free call on Calendly (opens in a new tab)">
          <span>
            <span class="linkbio__cta-label">📅 Book a free call</span>
            <span class="linkbio__cta-sub">Calendly · 30 minutes, no commitment</span>
          </span>
        </a>
      </div>
    </div>
  </main>
{% endblock %}

{% block before_scripts %}
  <script>
    (function () {
      window.plausible = window.plausible || function () {
        (window.plausible.q = window.plausible.q || []).push(arguments);
      };
      document.querySelectorAll('[data-cta]').forEach(function (el) {
        el.addEventListener('click', function () {
          window.plausible('CTA Click', { props: { link: el.dataset.cta } });
        });
      });
    })();
  </script>
{% endblock %}
