{% block body %}
  <main>

    <section class="hero" id="accueil" aria-label="Introduction">
      <div class="container">
        <div class="hero__grid">

          <div class="hero__content">
            <p class="hero__tag">Dépannage et conseil informatique · Saint-Pierre, La Réunion</p>

            <h1 class="hero__title">
              Un problème informatique,<br>
              <em>et personne à appeler ?</em>
            </h1>

            <p class="hero__subtitle">
              Site en panne, boîte mail qui déborde, fichiers impossibles à récupérer,
              prestataire qui a disparu. Je m'en occupe, et je vous explique ce que
              j'ai fait avec des mots normaux. 18 ans de métier, basé à Saint-Pierre.
            </p>

            <div class="hero__ctas">
              <a href="contact.html"
                 class="btn btn--primary btn--lg"
                 aria-label="Me décrire votre problème informatique">
                Expliquez-moi votre problème →
              </a>
              <a href="https://calendly.com/matthieu-viel-fr/30min"
                 class="btn btn--outline btn--lg"
                 target="_blank"
                 rel="noopener noreferrer"
                 aria-label="Réserver un appel de 30 minutes (ouvre Calendly)">
                Réserver un appel de 30 min
              </a>
            </div>

            <hr class="hero__divider" aria-hidden="true">

            <ul class="hero__stats">
              <li class="hero__stat">
                <span class="hero__stat-number">18</span>
                <span class="hero__stat-label">ans de métier</span>
              </li>
              <li class="hero__stat">
                <span class="hero__stat-number">24h</span>
                <span class="hero__stat-label">délai de réponse</span>
              </li>
              <li class="hero__stat">
                <span class="hero__stat-number">974</span>
                <span class="hero__stat-label">La Réunion</span>
              </li>
            </ul>
          </div>

          <div class="hero__visual" aria-hidden="true">
            <div class="hero__photo-wrap">
              <img src="{{ asset_base }}assets/images/portrait.webp"
                   alt="Matthieu Viel, dépannage et conseil informatique à Saint-Pierre, La Réunion"
                   class="hero__photo"
                   width="400"
                   height="400"
                   loading="eager">
            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="section--doors" id="portes" aria-labelledby="portes-title">
      <div class="container">
        <header class="section-header doors__header">
          <p class="eyebrow">Par où commencer</p>
          <h2 class="section-title" id="portes-title">Vous êtes au bon endroit si...</h2>
        </header>

        <div class="doors__grid">

          <a class="door-card" href="#aide">
            <span class="door-card__icon" aria-hidden="true">🙋</span>
            <span class="door-card__title">Vous n'êtes pas informaticien</span>
            <span class="door-card__text">
              Vous dirigez votre activité, pas un service informatique. Il vous faut
              quelqu'un de fiable quand ça coince, qui répond et qui explique.
            </span>
            <span class="door-card__link">Ce que je fais pour vous →</span>
          </a>

          <a class="door-card" href="#technique">
            <span class="door-card__icon" aria-hidden="true">⚙️</span>
            <span class="door-card__title">Vous avez une équipe technique</span>
            <span class="door-card__text">
              Vous avez un produit, une application, des développeurs. Il vous faut
              un regard senior extérieur sur ce qui bloque.
            </span>
            <span class="door-card__link">Mes interventions techniques →</span>
          </a>

        </div>
      </div>
    </section>

    <section class="section" id="aide" aria-labelledby="aide-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">Vous n'êtes pas informaticien</p>
          <h2 class="section-title" id="aide-title">
            Ce que je fais concrètement
          </h2>
          <p class="section-subtitle section-subtitle--full">
            Vous n'avez pas besoin de nommer le problème. Si vous vous reconnaissez ici, je peux vous aider.
          </p>
        </header>

        <div class="help__grid">

          <article class="help-card fade-up">
            <div class="help-card__icon" aria-hidden="true">🔌</div>
            <h3 class="help-card__title">Votre site ne s'affiche plus</h3>
            <p class="help-card__text">
              Page blanche, message d'erreur, site introuvable. Je cherche d'où ça vient
              et je le remets en ligne. Souvent dans la journée.
            </p>
          </article>

          <article class="help-card fade-up">
            <div class="help-card__icon" aria-hidden="true">🔒</div>
            <h3 class="help-card__title">Votre site a été piraté</h3>
            <p class="help-card__text">
              Je nettoie, je referme la porte d'entrée, et je vous explique comment
              c'est arrivé pour que ça ne recommence pas.
            </p>
          </article>

          <article class="help-card fade-up">
            <div class="help-card__icon" aria-hidden="true">🔑</div>
            <h3 class="help-card__title">Votre prestataire a disparu</h3>
            <p class="help-card__text">
              Je récupère les accès, le nom de domaine et l'hébergement, puis je reprends
              la main sur votre site. Vous redevenez propriétaire de vos outils.
            </p>
          </article>

          <article class="help-card fade-up">
            <div class="help-card__icon" aria-hidden="true">📂</div>
            <h3 class="help-card__title">Vous n'arrivez pas à récupérer vos fichiers</h3>
            <p class="help-card__text">
              Serveur, espace de stockage, boîte mail pleine. Je vais les chercher,
              et je vous montre comment faire la prochaine fois.
            </p>
          </article>

          <article class="help-card fade-up">
            <div class="help-card__icon" aria-hidden="true">💾</div>
            <h3 class="help-card__title">Personne ne sait si vos sauvegardes existent</h3>
            <p class="help-card__text">
              Je vérifie ce qui est sauvegardé et ce qui ne l'est pas, je mets en place
              ce qui manque, et je vous dis quoi surveiller.
            </p>
          </article>

          <article class="help-card fade-up">
            <div class="help-card__icon" aria-hidden="true">⏱️</div>
            <h3 class="help-card__title">Une tâche vous mange du temps chaque semaine</h3>
            <p class="help-card__text">
              Recopier des données, renommer des fichiers, envoyer les mêmes documents.
              Je regarde si ça peut se faire tout seul. Souvent, oui.
            </p>
          </article>

        </div>

        <div class="help__cta">
          <a href="contact.html"
             class="btn btn--primary btn--lg"
             aria-label="Me décrire votre problème informatique">
            Expliquez-moi votre problème →
          </a>
          <p class="help__cta-note">
            Vous ne savez pas dans quelle case vous êtes ? Écrivez-moi quand même, je vous le dirai.
          </p>
        </div>
      </div>
    </section>

    <section class="section section--alt" id="deroulement" aria-labelledby="deroulement-title">
      <div class="container">
        <header class="section-header section-header--center">
          <p class="eyebrow">Comment ça se passe</p>
          <h2 class="section-title" id="deroulement-title">
            Trois étapes, aucune mauvaise surprise
          </h2>
          <p class="section-subtitle">
            Pas de jargon, pas de devis opaque, pas de dépendance créée exprès.
          </p>
        </header>

        <div class="steps">

          <div class="step fade-up">
            <div class="step__number" aria-hidden="true">1</div>
            <h3 class="step__title">Vous m'expliquez avec vos mots</h3>
            <p class="step__text">
              Décrivez simplement ce que vous voyez. Vous n'avez rien à préparer,
              et il n'y a pas de question bête.
            </p>
          </div>

          <div class="step fade-up">
            <div class="step__number" aria-hidden="true">2</div>
            <h3 class="step__title">Je regarde, puis je vous dis le prix</h3>
            <p class="step__text">
              Ce qui se passe, ce que ça coûte, combien de temps ça prend.
              Vous décidez ensuite, en connaissance de cause.
            </p>
          </div>

          <div class="step fade-up">
            <div class="step__number" aria-hidden="true">3</div>
            <h3 class="step__title">Je répare, et je vous montre</h3>
            <p class="step__text">
              Je vous explique ce qui a changé et ce qu'il faut surveiller.
              Mon objectif n'est pas que vous m'appeliez toutes les semaines.
            </p>
          </div>

        </div>

        <p class="solution__note">
          🎓 Formateur certifié ECP Formation : je transmets, je ne me rends pas indispensable.
        </p>
      </div>
    </section>

    <section class="section" id="preuves" aria-labelledby="preuves-title">
      <div class="container">
        <header class="section-header section-header--center">
          <p class="eyebrow">Pourquoi me faire confiance</p>
          <h2 class="section-title" id="preuves-title">18 ans de métier, et des clients qui le disent</h2>
        </header>

        <div class="proof__grid">
          <div class="stat-card fade-up">
            <p class="stat-card__number">18</p>
            <p class="stat-card__label">ans d'expérience fullstack</p>
          </div>
          <div class="stat-card fade-up">
            <p class="stat-card__number">500+</p>
            <p class="stat-card__label">scénarios de tests automatisés</p>
          </div>
          <div class="stat-card fade-up">
            <p class="stat-card__number">70%</p>
            <p class="stat-card__label">de couverture de tests atteinte (Citeo)</p>
          </div>
          <div class="stat-card fade-up">
            <p class="stat-card__number">8+</p>
            <p class="stat-card__label">recommandations LinkedIn vérifiées</p>
          </div>
        </div>

        <div class="proof__cert fade-up" role="group" aria-label="Certification formateur">
          <span class="proof__cert-icon" aria-hidden="true">🏅</span>
          <div>
            <p class="proof__cert-title">Formateur certifié ECP Formation</p>
            <p class="proof__cert-sub">
              Formation professionnelle « Concevoir et animer une formation en présentiel et à distance »
            </p>
          </div>
        </div>

        <div class="testimonials__grid" role="group" aria-label="Témoignages">

          <article class="testimonial fade-up">
            <span class="testimonial__stars" role="img" aria-label="5 étoiles">★★★★★</span>
            <p class="testimonial__quote">
              A permis de sécuriser les mises en production et d'augmenter la vélocité de l'équipe.
            </p>
            <div class="testimonial__author">
              <p class="testimonial__name">Stéphane Bourdon</p>
              <p class="testimonial__role">Head of IT · Citeo</p>
            </div>
          </article>

          <article class="testimonial fade-up">
            <span class="testimonial__stars" role="img" aria-label="5 étoiles">★★★★★</span>
            <p class="testimonial__quote">
              Sérieux, fiable, fédérateur, n'a pas peur d'aborder de nouveaux challenges.
            </p>
            <div class="testimonial__author">
              <p class="testimonial__name">Stéphane Jauffret</p>
              <p class="testimonial__role">CEO · Sellermania</p>
            </div>
          </article>

          <article class="testimonial fade-up">
            <span class="testimonial__stars" role="img" aria-label="5 étoiles">★★★★★</span>
            <p class="testimonial__quote">
              Tout ce qu'on attend d'un développeur expérimenté : précis, autonome, et pédagogue.
            </p>
            <div class="testimonial__author">
              <p class="testimonial__name">Pierre-Charles Bertineau</p>
              <p class="testimonial__role">Lead Dev · Néosylva</p>
            </div>
          </article>

        </div>
      </div>
    </section>

    <section class="section--clients" aria-labelledby="clients-title">
      <div class="container">
        <p class="eyebrow clients__eyebrow" id="clients-title">Ils m'ont fait confiance</p>
        <ul class="sr-only">
