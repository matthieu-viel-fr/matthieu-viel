            </div>
          </article>

        </div>
      </div>
    </section>

    <section class="section section--alt" id="interventions" aria-labelledby="interventions-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">Cas concrets</p>
          <h2 class="section-title" id="interventions-title">Dans quelles situations ?</h2>
