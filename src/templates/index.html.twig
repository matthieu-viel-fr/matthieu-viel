        "@type": "Question",
        "name": "En combien de temps répondez-vous ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sous 24h par email. Pour une urgence comme un site hors ligne ou un piratage, appelez directement le +262 693 85 28 12."
        }
      }
